# Copia este archivo a .env.local y llena los valores.
#
# Local (con `supabase start` corriendo, requiere Docker):
#   los valores por default de abajo ya funcionan tal cual —
#   `supabase status` los confirma si los cambiaste.
#
# Supabase Cloud (proyecto real, sin Docker):
#   Project Settings → API, en el dashboard de supabase.com.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
